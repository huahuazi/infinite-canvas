# 管理员账号，首次启动会自动创建。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=infinite-canvas

# JWT 登录密钥和过期时间，正式部署请修改 JWT_SECRET。
JWT_SECRET=infinite-canvas
JWT_EXPIRE_HOURS=168

# 后端默认监听 8080，如需本地开发修改端口再取消注释。
# Docker 镜像内前端固定监听 3000，避免覆盖前端 PORT。
# PORT=8080

# 公开访问地址，用于把本地上传的 Seedance 参考图/视频暴露给火山方舟拉取。
# 线上部署时填写站点根地址，例如：https://your-domain.example.com
# PUBLIC_BASE_URL=https://your-domain.example.com

# 公共直链镜像：自建素材出口不可用（未配 PUBLIC_BASE_URL、只有 IPv6、上行打满）时，
# 自动把素材转存到公共文件托管换一条上游能拉的直链，全程对用户无感。
#   fallback（默认）：仅在自建出口失败时兜底；off：完全关闭。
# ⚠️ 这些托管是公开可读的，素材上传即公开；客户素材 / 未发布素材请设为 off。
# PUBLIC_MIRROR_MODE=fallback
# 按顺序尝试，任一成功即返回；未知名字会被忽略。可只留一个，例如 catbox。
# PUBLIC_MIRROR_PROVIDERS=catbox,0x0st,litterbox,tmpfiles
# 生成结果（成片）是否也镜像到公共托管：默认 false，避免成片被公开。
# 只有在服务端对象存储不可用、又需要保活 24 小时链接时才打开。
# PUBLIC_MIRROR_RESULTS=false

# 前端开发代理默认使用 http://127.0.0.1:8080，如后端开发端口不同，启动前端时可单独设置 API_BASE_URL。
# API_BASE_URL=http://127.0.0.1:8080

# 服务器托管 Agent（docker compose 部署时必填，缺失会出现“/api/agent/health 正常但 /events 返回 401”）。
# AGENT_TOKEN 是 app 容器反代与 agent 容器共用的连接令牌，两边必须完全一致：
#   - agent 容器读它作为 AGENT_TOKEN；
#   - app 容器读它并注入 x-canvas-agent-token 请求头。
# 生成示例：openssl rand -hex 18
# 留空时 agent 容器会自行随机生成 token，app 容器拿不到同一个值，画布就会连不上。
# ⚠️ 下面只是占位示例值：生产部署务必替换为随机值（openssl rand -hex 18），不要直接照抄示例上线。
AGENT_TOKEN=please-change-me-to-a-random-token

# app 容器反代 /api/agent/* 的目标地址，默认 http://agent:17371（compose 服务名，容器网络内可直连）。
# 只有 agent 不在同一个 compose 网络里时才需要改，例如指向宿主机：http://host.docker.internal:17371
# AGENT_PROXY_URL=http://agent:17371

# 外部智能体接入密钥（可选，但强烈建议单独配置）：
#   - 用于校验 /api/agent/mcp（Codex / Claude Code 的 MCP 端点）；
#   - 同时是 agent 容器调用 /api/agent-canvas/*（无头画布通道）的服务间密钥；
#   - 留空时回退使用上面的 AGENT_TOKEN。
# 每个用户自己的接入凭据由后端按用户签发（画布侧边栏「复制 MCP 命令」已自动带上），
# 这里只保存服务器级密钥；轮换后所有已签发的用户 token 一起失效。
# 生成示例：openssl rand -hex 24
# AGENT_MCP_KEY=

# 数据库配置，默认使用本地 SQLite。
STORAGE_DRIVER=sqlite
# sqlite: DATABASE_DSN=data/infinite-canvas.db
# Docker 部署时建议使用绝对路径，避免工作目录变化后写入临时库：DATABASE_DSN=/app/data/infinite-canvas.db
# mysql 目标库不存在时会尝试自动创建，账号需有 CREATE 权限。
# mysql: DATABASE_DSN=user:password@tcp(127.0.0.1:3306)/infinite_canvas?parseTime=true
# postgres 目标库不存在时会尝试自动创建，账号需有 CREATEDB 权限。
# postgres: DATABASE_DSN=postgres://user:password@127.0.0.1:5432/infinite_canvas?sslmode=disable
DATABASE_DSN=data/infinite-canvas.db
