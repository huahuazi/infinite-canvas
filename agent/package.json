{
    "name": "@tigerowo/infinite-canvas-agent",
    "version": "0.1.0",
    "description": "Local Agent service for the Infinite Canvas workspace. Bridges the web canvas to Codex, Claude Code, generic CLI agents and OpenAI-compatible endpoints through MCP.",
    "type": "module",
    "license": "MIT",
    "bin": {
        "infinite-canvas-agent": "dist/index.js"
    },
    "files": [
        "dist",
        "agent-instructions.md"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "tsx src/index.ts",
        "dev:mcp": "tsx src/index.ts mcp",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.12.1",
        "express": "^5.1.0",
        "strip-ansi": "7.2.0",
        "winston": "^3.19.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/express": "^5.0.0",
        "@types/node": "^22.0.0",
        "tsx": "^4.19.0",
        "typescript": "^5.6.0"
    }
}
